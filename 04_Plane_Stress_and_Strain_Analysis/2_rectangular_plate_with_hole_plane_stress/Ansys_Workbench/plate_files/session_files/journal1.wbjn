# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
template1 = GetTemplate(TemplateName="Geometry")
system1 = template1.CreateSystem()
template2 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
geometryComponent1 = system1.GetComponent(Name="Geometry")
system2 = template2.CreateSystem(
    ComponentsToShare=[geometryComponent1],
    Position="Right",
    RelativeTo=system1)
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometryProperties1 = geometry1.GetGeometryProperties()
geometryProperties1.GeometryImportAnalysisType = "AnalysisType_2D"
geometry1.Edit()
geometry1.Exit()
modelComponent1 = system2.GetComponent(Name="Model")
modelComponent1.Refresh()
system2.Delete()
Save(Overwrite=True)
geometry1.Edit()
system3 = template2.CreateSystem(
    ComponentsToShare=[geometryComponent1],
    Position="Right",
    RelativeTo=system1)
modelComponent2 = system3.GetComponent(Name="Model")
modelComponent2.Refresh()
geometry1.Exit()
system4 = template1.CreateSystem(
    Position="Below",
    RelativeTo=system1)
geometry2 = system4.GetContainer(ComponentName="Geometry")
geometry2.Edit(IsDiscoveryGeometry=True)
system3.Delete()
system1.Delete()
geometry2.Edit()
geometryComponent2 = system4.GetComponent(Name="Geometry")
system5 = template2.CreateSystem(
    ComponentsToShare=[geometryComponent2],
    Position="Right",
    RelativeTo=system4)
modelComponent3 = system5.GetComponent(Name="Model")
modelComponent3.Refresh()
model1 = system5.GetContainer(ComponentName="Model")
model1.Edit()
Save(Overwrite=True)
geometry2.Exit()
Save(Overwrite=True)
model1.Exit()
